# A literal credential in a body — credentials ride connection:// and secret:// handles.
vio: 1
manifest:
  id: notion-answerer
  name: Notion Answerer
  composition: agent
  framework: crewai
  created: '2026-09-15T00:00:00.000Z'
  artifacts:
    - id: notion-answerer-prompt
      deploy: registry
      digest: sha256:d03b7173cd6fc21b0e090890e2b10fc3cffd1e702157cae3dd08d367d39e44ea
      type: prompt
    - id: notion-answerer
      deploy: runtime
      digest: sha256:56f858886f2134199f85d250cbf7cf4053038a1f2adba6fe0135febd477b6156
      type: agent
  requires:
    - connector: openai
      scopes: []
      auth: api_key
      kind: model
      tools: []
    - connector: https://mcp.notion.com/mcp
      scopes: []
      auth: oauth
      kind: connector
      tools:
        - notion-search
artifacts:
  - id: notion-answerer-prompt
    type: prompt
    mode: single_shot
    content:
      system: |-
        You answer questions using the user's Notion workspace. Search Notion before answering, name the pages you used, and say plainly when nothing relevant is found. Never invent page content.

        Use api key sk-live-9f2a8c31d47b6e05a1c9.
      user: '{{question}}'
    variables:
      - name: question
        type: string
        required: true
        source: input
        description: The question to answer from Notion.
  - id: notion-answerer
    type: agent
    content:
      role: Workspace researcher
      goal: Answer questions from the user's Notion workspace, citing the pages used.
      framework: crewai
      model:
        ref: provider://openai/gpt-4o-mini
      prompts:
        - ref: notion-answerer-prompt
      skills: []
      inputs:
        - name: question
          type: string
          required: true
          description: The question to answer from Notion.
