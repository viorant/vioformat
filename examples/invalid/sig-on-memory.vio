      name: session-notes
      description: Persistent memory for agent runs.
      ---
  - id: research-notes
    type: agent
    content:
      role: Research assistant
      goal: Answer from accumulated notes and keep them current.
      framework: crewai
      model:
        ref: provider://openai/gpt-4o-mini
      prompts:
        - ref: research-notes-prompt
