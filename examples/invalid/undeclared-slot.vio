# INVALID — §2.4: the prompt uses a {{slot}} it does not declare in variables[]. Expect: reject (undeclared_variable).
vio: 1
manifest:
  id: bad_slot
  name: Stray Slot
  version: 0.1.0
  composition: prompt
  org: example
  team: docs
  signer: { certificate_id: cert_example_001, algo_id: 0x02 }
  created: 2026-09-16T00:00:00Z
  artifacts:
    - { id: p, type: prompt, deploy: registry, digest: "sha256:0000", sig: "base64" }
artifacts:
  - id: p
    type: prompt
    mode: chat
    content:
      system: |
        You greet {{name}} on behalf of {{client}}.
    variables:
      - { name: name, type: string, required: true, source: input }
    bindings:
      name: input.name
