# {{tone}} used but absent from variables[] — every slot is declared or the run cannot bind it.
vio: 1
manifest:
  id: summarizer
  name: Summarizer
  composition: agent
  framework: crewai
  created: '2026-09-15T00:00:00.000Z'
  artifacts:
    - id: summarizer-prompt
      deploy: registry
      digest: sha256:e203cccf2dab7a995b71e34c0ed1be20eac3a3d4c4a0380d3f2099e289eda8ce
      type: prompt
    - id: summarizer
      deploy: runtime
      digest: sha256:16a546abb7772d65296296dcd1636780ca8f677f71afffa6d109d91ec926743b
      type: agent
  requires:
    - connector: openai
      scopes: []
      auth: api_key
      kind: model
      tools: []
artifacts:
  - id: summarizer-prompt
    type: prompt
    mode: single_shot
    content:
      system: You are a concise assistant. Summarize the text you are given in exactly three bullet points. Do not add anything that is not in the text.
      user: |-
        Summarize this:

        {{text}}

        Tone: {{tone}}
    variables:
      - name: text
        type: string
        required: true
        source: input
        description: The text to summarize.
  - id: summarizer
    type: agent
    content:
      role: Summarizer
      goal: Turn any text into a three-bullet summary.
      framework: crewai
      model:
        ref: provider://openai/gpt-4o-mini
      prompts:
        - ref: summarizer-prompt
      skills: []
      inputs:
        - name: text
          type: string
          required: true
          description: The text to summarize.
