# The worked example from the specification (§1.4).
# A CrewAI research agent: signed prompt, one declarative and one executable skill,
# a memory reference and a self-hosted model reference.
vio: 1
manifest:
  id: agt_research
  name: Research Analyst
  version: 1.2.0
  composition: agent
  framework: crewai
  org: viorant
  team: rnd
  signer: { certificate_id: cert_adi_001, algo_id: 0x02 }   # RSA-2048 + ECDSA-P256
  created: 2026-06-14T10:00:00Z
  artifacts:
    - { id: agent,     type: agent,  deploy: runtime,  digest: "sha256:9f2a", sig: "base64" }
    - { id: sysprompt, type: prompt, deploy: registry, digest: "sha256:0c41", sig: "base64" }
    - { id: summarize, type: skill,  kind: declarative, deploy: registry, digest: "sha256:1b7e", sig: "base64" }
    - { id: websearch, type: skill,  kind: executable, runtime: python, deploy: runtime/standalone, digest: "sha256:aa90", sig: "base64" }
    - { id: mem,       type: memory, deploy: store,    ref: "mem://viorant/rnd/research", digest: "sha256:dd12" }
    - { id: llama,     type: model,  deploy: runtime,  ref: "model://viorant/llama3-8b",
        engine: vllm, quantization: q4_k_m, context_length: 8192, served_as: llama3-8b, digest: "sha256:7c33" }
  requires:
    - { ref: llama, digest: "sha256:7c33" }
    - { connector: serpapi, scopes: [search.read], auth: oauth }
artifacts:
  - id: agent
    type: agent
    content:
      role: Senior Research Analyst
      goal: Produce rigorous, cited research briefs
      framework: crewai
      model:   { ref: llama, params: { temperature: 0.2, max_tokens: 1500 } }
      prompts: [ { ref: sysprompt } ]
      skills:  [ { ref: summarize }, { ref: websearch, deploy: standalone } ]
      memory:  { ref: mem }
      inputs:
        - { name: client, type: string, required: true }
        - { name: topic,  type: string, required: true }
      bindings:
        sysprompt.client: input.client
        sysprompt.topic:  input.topic
      output:
        expected: |
          5-bullet executive summary with inline citations.
        schema:
          type: object
          properties:
            summary:   { type: array, items: { type: string } }
            citations: { type: array, items: { type: string } }
          required: [summary, citations]
  - id: sysprompt
    type: prompt
    mode: chat
    content:
      system: |
        You are a meticulous research analyst for {{client}}. Cite every claim.
      user: |
        Research {{topic}} and produce a brief.
    variables:
      - { name: client, type: string, required: true, source: input }
      - { name: topic,  type: string, required: true, source: input }
    bindings:
      client: input.client
      topic:  input.topic
  - id: summarize
    type: skill
    content: |
      # Summarize
      When given documents, produce a 5-bullet executive summary.
  - id: websearch
    type: skill
    tools:
      - { ref: http_get,   kind: viorant }
      - { ref: serp_query, kind: mcp, connector: serpapi, scopes: [search.read] }
    content: |
      def run(query: str) -> list[dict]:
          # executable python skill; deployed as its own sidecar container
          # tokens injected at run via connection://, never in the .vio
          ...
  # mem and llama have no body — they are refs resolved on the target at deploy
