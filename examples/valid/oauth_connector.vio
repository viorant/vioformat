# Canonical .vio example (VIOR-930). Schema: @viorant/shared/vio-bundle.schema.json
# Every digest is real: sha256 of the RFC 8785 canonical JSON of the body without `id` and `type`.
# Edit a body and its digest must be recomputed, or deploy rejects the bundle.
# An agent that calls an OAuth MCP connector. The user authorises Notion at deploy time; no token is ever stored in the bundle.
vio: 1
manifest:
  id: notion-answerer
  name: Notion Answerer
  composition: agent
  framework: crewai
  created: '2026-09-15T00:00:00.000Z'
  artifacts:
    - id: notion-answerer-prompt
      deploy: registry
      digest: sha256:87a2df4c6166fdb254cc41ae6947fa2cb8af42dc6fe76550907224ac52904d0d
      type: prompt
    - id: notion-answerer
      deploy: runtime
      digest: sha256:56f858886f2134199f85d250cbf7cf4053038a1f2adba6fe0135febd477b6156
      type: agent
  requires:
    - connector: openai
      scopes: []
      auth: api_key
      kind: model
      tools: []
    - connector: https://mcp.notion.com/mcp
      scopes: []
      auth: oauth
      kind: connector
      tools:
        - notion-search
artifacts:
  - id: notion-answerer-prompt
    type: prompt
    mode: single_shot
    content:
      system: You answer questions using the user's Notion workspace. Search Notion before answering, name the pages you used, and say plainly when nothing relevant is found. Never invent page content.
      user: '{{question}}'
    variables:
      - name: question
        type: string
        required: true
        source: input
        description: The question to answer from Notion.
  - id: notion-answerer
    type: agent
    content:
      role: Workspace researcher
      goal: Answer questions from the user's Notion workspace, citing the pages used.
      framework: crewai
      model:
        ref: provider://openai/gpt-4o-mini
      prompts:
        - ref: notion-answerer-prompt
      skills: []
      inputs:
        - name: question
          type: string
          required: true
          description: The question to answer from Notion.
