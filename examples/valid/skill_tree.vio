# Canonical .vio example (VIOR-930). Schema: @viorant/shared/vio-bundle.schema.json
# Every digest is real: sha256 of the RFC 8785 canonical JSON of the body without `id` and `type`.
# Edit a body and its digest must be recomputed, or deploy rejects the bundle.
# An agent with a declarative skill: a SKILL.md with `name` and `description` frontmatter.
vio: 1
manifest:
  id: meeting-notes-agent
  name: Meeting Notes
  composition: agent
  framework: crewai
  created: '2026-09-15T00:00:00.000Z'
  artifacts:
    - id: meeting-notes
      deploy: runtime
      digest: sha256:e4220b142406dcd244aafaf8b3efe857a752d06530711d4760959c62a2c9d4f7
      type: skill
      kind: declarative
    - id: meeting-notes-prompt
      deploy: registry
      digest: sha256:5a85f4daee63d0ed925605a0271af79747005576b8348d6754675b950b60d8e5
      type: prompt
    - id: meeting-notes-agent
      deploy: runtime
      digest: sha256:adad22aedf466da49f20cc9e139d69d40dd8c9d53c417ca1697c476c4ce3b3c1
      type: agent
  requires:
    - connector: openai
      scopes: []
      auth: api_key
      kind: model
      tools: []
artifacts:
  - id: meeting-notes
    type: skill
    content: |
      ---
      name: meeting-notes
      description: Turn a raw meeting transcript into structured notes with decisions, action items and owners. Use when given a transcript or rough notes from a meeting.
      ---

      # Meeting notes

      1. Read the whole transcript before writing anything.
      2. List the decisions made, one line each.
      3. List action items as `- [ ] owner: task (due date, if one was stated)`.
      4. Never invent an owner or a date. Write `unassigned` when no owner was named.
  - id: meeting-notes-prompt
    type: prompt
    mode: single_shot
    content:
      system: You turn meeting transcripts into notes people can act on. Follow the meeting-notes skill exactly.
      user: |-
        Transcript:

        {{transcript}}
    variables:
      - name: transcript
        type: string
        required: true
        source: input
        description: The raw meeting transcript.
  - id: meeting-notes-agent
    type: agent
    content:
      role: Meeting note-taker
      goal: Produce decisions and owned action items from a meeting transcript.
      framework: crewai
      model:
        ref: provider://openai/gpt-4o-mini
      prompts:
        - ref: meeting-notes-prompt
      skills:
        - ref: meeting-notes
      inputs:
        - name: transcript
          type: string
          required: true
          description: The raw meeting transcript.
