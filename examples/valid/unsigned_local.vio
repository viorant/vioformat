# A local compile-and-run bundle (§3): no signatures anywhere. Valid — signing is optional.
# A Level 3 deployer will refuse it; a Level 1 reader accepts it with a warning.
vio: 1
manifest:
  id: agt_local
  name: Local Draft
  version: 0.0.1
  composition: agent
  framework: crewai
  org: example
  team: docs
  signer: { certificate_id: cert_unsigned_local, algo_id: 0x02 }
  created: 2026-09-16T09:00:00Z
  artifacts:
    - { id: agent, type: agent,  deploy: runtime,  digest: "sha256:4444" }
    - { id: p,     type: prompt, deploy: registry, digest: "sha256:5555" }
artifacts:
  - id: agent
    type: agent
    content:
      role: Drafter
      goal: Draft quickly during development
      framework: crewai
      prompts: [ { ref: p } ]
      inputs:
        - { name: topic, type: string, required: true }
  - id: p
    type: prompt
    mode: chat
    content:
      user: |
        Draft a short note about {{topic}}.
    variables:
      - { name: topic, type: string, required: true, source: input }
    bindings:
      topic: input.topic
